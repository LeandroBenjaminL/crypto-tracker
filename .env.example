# Crypto Tracker Configuration
# Copy this file to .env and fill in your values

# CoinGecko API (free, no key required for basic usage)
# Get a free API key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Optional: Custom API base URL (for testing)
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional: Default currency for prices
DEFAULT_CURRENCY=usd

# Optional: Cache TTL in seconds (for rate limiting)
CACHE_TTL=60

# Optional: PostgreSQL connection (for favorites storage)
# Si se configura, los favoritos se guardan en DB en vez de JSON.
# En Docker se configura automáticamente.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
