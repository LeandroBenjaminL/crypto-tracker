# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cache directories (ruff, mypy, etc.)
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables (keep secrets safe)
.env

# Streamlit secrets (the actual file, not the example)
.streamlit/secrets.toml

# Distribution / packaging
dist/
build/
*.egg-info/

# Testing & coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Local databases (SQLite, etc.)
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Node / frontend
node_modules/

# Data (pipeline output — may be large)
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Project specific
.crypto_tracker.json  # Local favorites file
