---
// Página 404 que detecta si es una URL de precio y carga el detalle client-side.
// Esto cubre monedas que no fueron pre-renderizadas en getStaticPaths.
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/crypto-tracker/favicon.svg" />
    <link rel="icon" href="/crypto-tracker/favicon.ico" />
    <title>Crypto Tracker</title>
    <style is:global>
      *,
      *::before,
      *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg: #0a0e1a; --bg-card: #131830; --bg-card-hover: #1a2140;
        --bg-nav: #0f1525; --border: rgba(255,255,255,0.06);
        --text: #f0f0f0; --text-secondary: #999; --text-muted: rgba(255,255,255,0.4);
        --green: #00d4aa; --red: #ff6b6b; --accent: #00d4aa;
        --radius: 12px; --shadow: 0 4px 24px rgba(0,0,0,0.3);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color-scheme: dark;
      }
      body { background: var(--bg); color: var(--text); min-height: 100vh; line-height: 1.5; }
      a { color: inherit; text-decoration: none; }
      .green { color: var(--green); }
      .red { color: var(--red); }
      .text-secondary { color: var(--text-secondary); }
      .text-muted { color: var(--text-muted); }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 1rem; }
      .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
               box-shadow: var(--shadow); padding: 1.25rem; }
      .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem;
              border-radius: 8px; border: 1px solid var(--border); background: var(--bg-card);
              color: var(--text); font-size: 0.85rem; cursor: pointer; }
      .btn:hover { background: var(--bg-card-hover); }
      .spinner { width: 24px; height: 24px; border: 3px solid var(--border);
                 border-top-color: var(--accent); border-radius: 50%;
                 animation: spin 0.8s linear infinite; margin: 2rem auto; }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <nav style="background: var(--bg-nav); border-bottom: 1px solid var(--border); padding: 0.75rem 0; position: sticky; top: 0; z-index: 100; backdrop-filter: blur(8px);">
      <div class="container" style="display: flex; align-items: center; gap: 1.5rem">
        <a href="/crypto-tracker/" style="font-weight: 700; font-size: 1.1rem">📈 Crypto Tracker</a>
        <div style="display: flex; gap: 0.75rem; font-size: 0.85rem; flex-wrap: wrap">
          <a href="/crypto-tracker/" style="padding: 0.3rem 0.6rem">Inicio</a>
          <a href="/crypto-tracker/top" style="padding: 0.3rem 0.6rem">Top</a>
          <a href="/crypto-tracker/search" style="padding: 0.3rem 0.6rem">Buscar</a>
          <a href="/crypto-tracker/favorites" style="padding: 0.3rem 0.6rem">⭐ Favoritos</a>
        </div>
      </div>
    </nav>

    <main>
      <div class="container" style="padding-top: 2rem" id="root-404">
        <!-- Placeholder — JS lo reemplaza si detecta /price/{slug} -->
        <div style="text-align: center; padding: 3rem 0">
          <h1 style="font-size: 3rem; opacity: 0.3; margin-bottom: 0.5rem">404</h1>
          <p class="text-secondary">Pagina no encontrada.</p>
          <a href="/crypto-tracker/" class="btn" style="margin-top: 1.5rem">Volver al inicio</a>
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import { getPrice, getHistory, fmtPrice, fmtChange, fmtCap } from "../lib/api";
  const BASE = "/crypto-tracker";

  // Detectar si es /price/{slug}
  const path = location.pathname.replace(BASE, "").replace(/\/$/, "");
  const priceMatch = path.match(/^\/price\/(.+)$/);
  if (!priceMatch) {
    // No es una URL de precio. Dejar el mensaje 404 estatico.
  } else {
    const slug = priceMatch[1];
    renderCoinDetail(slug);
  }

  async function renderCoinDetail(slug) {
    const root = document.getElementById("root-404");
    if (!root) return;

    // Mostrar spinner
    root.innerHTML = `<div class="spinner"></div>`;

    try {
      const coin = await getPrice(slug);
      if (!coin || coin.price == null) {
        root.innerHTML = `
          <div style="text-align: center; padding: 2rem">
            <h1 style="font-size: 2rem; opacity: 0.5; margin-bottom: 0.5rem">${slug.toUpperCase()}</h1>
            <p class="text-muted">Moneda no encontrada.</p>
            <a href="${BASE}/" class="btn" style="margin-top: 1rem">Volver</a>
          </div>`;
        return;
      }

      const isUp = (coin.change_24h ?? 0) >= 0;
      const cc = isUp ? "green" : "red";
      const arrow = isUp ? "▲" : "▼";

      document.title = `${coin.symbol?.toUpperCase() ?? slug} — Crypto Tracker`;

      root.innerHTML = `
        <a href="${BASE}/" class="text-muted" style="font-size: 0.85rem">← Volver</a>

        <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 1rem; flex-wrap: wrap">
          <h1 style="font-size: 2rem; font-weight: 700">${coin.name || slug.toUpperCase()}</h1>
          <span class="text-muted" style="font-size: 1rem">${coin.symbol?.toUpperCase() ?? ""}</span>
        </div>

        <div class="card" style="margin-top: 1.25rem; max-width: 400px">
          <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.5">Precio Actual</div>
          <div style="font-size: 2.5rem; font-weight: 700; letter-spacing: -1px; margin-top: 0.25rem" class="${cc}">
            ${fmtPrice(coin.price)}
          </div>
          <div style="font-size: 1rem; margin-top: 0.25rem" class="${cc}">
            ${arrow} ${fmtChange(coin.change_24h ?? 0)}
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin-top: 1rem">
          <div class="card"><div class="text-muted" style="font-size: 0.75rem">Market Cap</div>
            <div style="font-size: 1.2rem; font-weight: 600; margin-top: 0.3rem">${coin.market_cap != null ? fmtCap(coin.market_cap) : "—"}</div></div>
          <div class="card"><div class="text-muted" style="font-size: 0.75rem">Volumen 24h</div>
            <div style="font-size: 1.2rem; font-weight: 600; margin-top: 0.3rem">${coin.volume_24h != null ? fmtCap(coin.volume_24h) : "—"}</div></div>
          <div class="card"><div class="text-muted" style="font-size: 0.75rem">Rank</div>
            <div style="font-size: 1.2rem; font-weight: 600; margin-top: 0.3rem">${coin.rank > 0 ? `#${coin.rank}` : "—"}</div></div>
        </div>

        <div style="margin-top: 2rem">
          <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem">Historico</h2>
          <div id="chart-404-container" class="card">
            <div class="spinner"></div>
          </div>
        </div>`;

      // Cargar chart
      loadChart404(slug);
    } catch {
      root.innerHTML = `
        <div style="text-align: center; padding: 2rem">
          <h1 style="font-size: 2rem; opacity: 0.5">${slug.toUpperCase()}</h1>
          <p class="text-muted">Error al cargar datos.</p>
          <a href="${BASE}/" class="btn" style="margin-top: 1rem">Volver</a>
        </div>`;
    }
  }

  async function loadChart404(slug) {
    const container = document.getElementById("chart-404-container");
    if (!container) return;
    try {
      const history = await getHistory(slug, 7);
      if (!history.length) {
        container.innerHTML = `<p class="text-muted" style="text-align: center">Sin datos historicos.</p>`;
        return;
      }
      const { Chart, registerables } = await import("chart.js");
      Chart.register(...registerables);

      const labels = history.map((p) => {
        const d = new Date(p.timestamp);
        return d.toLocaleDateString("es", { weekday: "short", hour: "2-digit" });
      });
      const prices = history.map((p) => p.price);
      const isUp = prices[0] <= prices[prices.length - 1];
      const color = isUp ? "#00d4aa" : "#ff6b6b";

      container.innerHTML = `<canvas id="chart-404-canvas" width="800" height="300" style="width:100%;height:auto"></canvas>`;
      const ctx = document.getElementById("chart-404-canvas").getContext("2d");
      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            data: prices,
            borderColor: color,
            backgroundColor: isUp ? "rgba(0,212,170,0.08)" : "rgba(255,107,107,0.08)",
            borderWidth: 2, fill: true, tension: 0.3, pointRadius: 0,
          }],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { color: "#666", maxTicksLimit: 10 } },
            y: { grid: { color: "rgba(255,255,255,0.04)" }, ticks: { color: "#666", callback: (v) => "$" + v.toLocaleString() } },
          },
          interaction: { intersect: false, mode: "index" },
        },
      });
    } catch {
      container.innerHTML = `<p class="text-muted" style="text-align: center">No se pudo cargar el grafico.</p>`;
    }
  }
</script>
