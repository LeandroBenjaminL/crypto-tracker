---
export async function getStaticPaths() {
  // Intentar obtener top 100 de CoinGecko en build time
  try {
    const res = await fetch(
      "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=100&page=1&sparkline=false",
    );
    if (res.ok) {
      const coins = await res.json();
      return coins.map((c: any) => ({ params: { slug: c.symbol } }));
    }
    throw new Error(`HTTP ${res.status}`);
  } catch {
    // Fallback: lista manual si CoinGecko falla (rate limit, red, etc.)
    const slugs = ["btc", "eth", "sol", "xrp", "ada", "doge", "dot", "avax", "link", "matic"];
    return slugs.map((slug) => ({ params: { slug } }));
  }
}

const { slug } = Astro.params;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/crypto-tracker/favicon.svg" />
    <link rel="icon" href="/crypto-tracker/favicon.ico" />
    <title>{slug.toUpperCase()} — Crypto Tracker</title>
    <style is:global>
      *,
      *::before,
      *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg: #0a0e1a; --bg-card: #131830; --bg-card-hover: #1a2140;
        --bg-nav: #0f1525; --border: rgba(255,255,255,0.06);
        --text: #f0f0f0; --text-secondary: #999; --text-muted: rgba(255,255,255,0.4);
        --green: #00d4aa; --red: #ff6b6b; --accent: #00d4aa;
        --radius: 12px; --shadow: 0 4px 24px rgba(0,0,0,0.3);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        color-scheme: dark;
      }
      body { background: var(--bg); color: var(--text); min-height: 100vh; line-height: 1.5; }
      a { color: inherit; text-decoration: none; }
      .green { color: var(--green); }
      .red { color: var(--red); }
      .text-secondary { color: var(--text-secondary); }
      .text-muted { color: var(--text-muted); }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 1rem; }
      .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
               box-shadow: var(--shadow); padding: 1.25rem; }
      .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem;
              border-radius: 8px; border: 1px solid var(--border); background: var(--bg-card);
              color: var(--text); font-size: 0.85rem; cursor: pointer; }
      .btn:hover { background: var(--bg-card-hover); }
      .spinner { width: 24px; height: 24px; border: 3px solid var(--border);
                 border-top-color: var(--accent); border-radius: 50%;
                 animation: spin 0.8s linear infinite; margin: 2rem auto; }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <!-- Nav -->
    <nav style="background: var(--bg-nav); border-bottom: 1px solid var(--border); padding: 0.75rem 0; position: sticky; top: 0; z-index: 100; backdrop-filter: blur(8px);">
      <div class="container" style="display: flex; align-items: center; gap: 1.5rem">
        <a href="/crypto-tracker/" style="font-weight: 700; font-size: 1.1rem">📈 Crypto Tracker</a>
        <div style="display: flex; gap: 0.75rem; font-size: 0.85rem; flex-wrap: wrap">
          <a href="/crypto-tracker/" style="padding: 0.3rem 0.6rem">Inicio</a>
          <a href="/crypto-tracker/top" style="padding: 0.3rem 0.6rem">Top</a>
          <a href="/crypto-tracker/search" style="padding: 0.3rem 0.6rem">Buscar</a>
          <a href="/crypto-tracker/favorites" style="padding: 0.3rem 0.6rem">⭐ Favoritos</a>
        </div>
      </div>
    </nav>

    <main>
      <div class="container" style="padding-top: 2rem">
        <!-- Back link -->
        <a href="/crypto-tracker/" class="text-muted" style="font-size: 0.85rem">← Volver</a>

        <!-- Header -->
        <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-top: 1rem; flex-wrap: wrap">
          <h1 id="coin-name" style="font-size: 2rem; font-weight: 700">{slug.toUpperCase()}</h1>
          <span id="coin-symbol" class="text-muted" style="font-size: 1rem"></span>
        </div>

        <!-- Price card -->
        <div class="card" style="margin-top: 1.25rem; max-width: 400px">
          <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.5">Precio Actual</div>
          <div id="price-value" style="font-size: 2.5rem; font-weight: 700; letter-spacing: -1px; margin-top: 0.25rem">—</div>
          <div id="price-change" style="font-size: 1rem; margin-top: 0.25rem">—</div>
        </div>

        <!-- Stats grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin-top: 1rem">
          <div class="card"><div class="text-muted" style="font-size: 0.75rem">Market Cap</div><div id="stat-cap" style="font-size: 1.2rem; font-weight: 600; margin-top: 0.3rem">—</div></div>
          <div class="card"><div class="text-muted" style="font-size: 0.75rem">Volumen 24h</div><div id="stat-vol" style="font-size: 1.2rem; font-weight: 600; margin-top: 0.3rem">—</div></div>
          <div class="card"><div class="text-muted" style="font-size: 0.75rem">Rank</div><div id="stat-rank" style="font-size: 1.2rem; font-weight: 600; margin-top: 0.3rem">—</div></div>
        </div>

        <!-- Favorites button -->
        <div style="margin-top: 1rem">
          <button id="fav-btn" class="btn" style="font-size: 0.9rem">☆ Agregar a favoritos</button>
        </div>

        <!-- Chart -->
        <div style="margin-top: 2rem">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem">
            <h2 style="font-size: 1.1rem; font-weight: 600">Histórico</h2>
            <div style="display: flex; gap: 0.4rem">
              <button class="btn chart-day" data-days="7" style="font-size: 0.8rem">7d</button>
              <button class="btn chart-day" data-days="30" style="font-size: 0.8rem">30d</button>
              <button class="btn chart-day" data-days="90" style="font-size: 0.8rem">90d</button>
            </div>
          </div>
          <div class="card">
            <canvas id="price-chart" width="800" height="350" style="width: 100%; height: auto"></canvas>
            <div id="chart-error" class="text-muted" style="margin-top: 0.5rem; text-align: center; font-size: 0.85rem; display: none">No hay datos históricos.</div>
          </div>
        </div>
      </div>
    </main>

    <footer style="text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: 0.8rem; border-top: 1px solid var(--border); margin-top: 3rem">
      Datos: CoinGecko &middot; Crypto Tracker &copy; 2026
    </footer>
  </body>
</html>

<script>
  import {
    getPrice,
    getHistory,
    fmtPrice,
    fmtChange,
    fmtCap,
  } from "../../lib/api";

  const BASE = "/crypto-tracker";

  // Detect slug from URL
  const slug = location.pathname.replace(BASE + "/price/", "").replace(/\/$/, "");

  let currentDays = 7;
  let chartInstance = null;

  // ── Load price data ──
  async function loadPrice() {
    try {
      const coin = await getPrice(slug);
      if (!coin) {
        document.getElementById("price-value").textContent = "No encontrada";
        return;
      }
      // Meta
      document.title = `${coin.symbol?.toUpperCase() ?? slug} — Crypto Tracker`;
      document.getElementById("coin-symbol").textContent = coin.symbol?.toUpperCase() ?? "";
      if (coin.name) {
        document.getElementById("coin-name").textContent = coin.name;
      }
      // Price
      const priceEl = document.getElementById("price-value");
      const changeEl = document.getElementById("price-change");
      if (coin.price != null) {
        const isUp = (coin.change_24h ?? 0) >= 0;
        priceEl.textContent = fmtPrice(coin.price);
        priceEl.style.color = isUp ? "var(--green)" : "var(--red)";
        changeEl.textContent = `${isUp ? "▲" : "▼"} ${fmtChange(coin.change_24h ?? 0)}`;
        changeEl.style.color = isUp ? "var(--green)" : "var(--red)";
      }
      // Stats
      document.getElementById("stat-cap").textContent =
        coin.market_cap != null ? fmtCap(coin.market_cap) : "—";
      document.getElementById("stat-vol").textContent =
        coin.volume_24h != null ? fmtCap(coin.volume_24h) : "—";
      document.getElementById("stat-rank").textContent =
        coin.rank > 0 ? `#${coin.rank}` : "—";

      // Favorites button
      updateFavButton(coin.symbol?.toLowerCase() ?? slug);
    } catch {
      document.getElementById("price-value").textContent = "Error";
    }
  }

  // ── Favorites (localStorage) ──
  function getFavorites() {
    try {
      return JSON.parse(localStorage.getItem("crypto_favorites") || "[]");
    } catch {
      return [];
    }
  }

  function saveFavorites(favs) {
    localStorage.setItem("crypto_favorites", JSON.stringify(favs));
  }

  function updateFavButton(symbol) {
    const btn = document.getElementById("fav-btn");
    if (!btn) return;
    const favs = getFavorites();
    if (favs.includes(symbol)) {
      btn.textContent = "⭐ Quitar de favoritos";
      btn.onclick = () => {
        saveFavorites(favs.filter((f) => f !== symbol));
        updateFavButton(symbol);
      };
    } else {
      btn.textContent = "☆ Agregar a favoritos";
      btn.onclick = () => {
        favs.push(symbol);
        saveFavorites(favs);
        updateFavButton(symbol);
      };
    }
  }

  // ── Chart ──
  async function loadChart(days) {
    currentDays = days;
    try {
      const history = await getHistory(slug, days);
      const chartError = document.getElementById("chart-error");
      const canvas = document.getElementById("price-chart");
      if (!history || history.length === 0) {
        chartError.style.display = "block";
        canvas.style.display = "none";
        return;
      }
      chartError.style.display = "none";
      canvas.style.display = "block";

      const labels = history.map((p) => {
        const d = new Date(p.timestamp);
        return days <= 7
          ? d.toLocaleDateString("es", { weekday: "short", hour: "2-digit" })
          : d.toLocaleDateString("es", { day: "numeric", month: "short" });
      });
      const prices = history.map((p) => p.price);

      // Dynamic import chart.js
      const { Chart, registerables } = await import("chart.js");
      Chart.register(...registerables);

      if (chartInstance) chartInstance.destroy();

      const isUp = prices.length >= 2 && prices[prices.length - 1] >= prices[0];
      const color = isUp ? "#00d4aa" : "#ff6b6b";
      const bgColor = isUp ? "rgba(0,212,170,0.08)" : "rgba(255,107,107,0.08)";

      const ctx = canvas.getContext("2d");
      chartInstance = new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [
            {
              data: prices,
              borderColor: color,
              backgroundColor: bgColor,
              borderWidth: 2,
              fill: true,
              tension: 0.3,
              pointRadius: 0,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              display: true,
              grid: { display: false },
              ticks: { color: "#666", maxTicksLimit: 10 },
            },
            y: {
              display: true,
              grid: { color: "rgba(255,255,255,0.04)" },
              ticks: { color: "#666", callback: (v) => "$" + v.toLocaleString() },
            },
          },
          interaction: { intersect: false, mode: "index" },
        },
      });
    } catch {
      document.getElementById("chart-error").style.display = "block";
    }
  }

  // ── Init ──
  document.addEventListener("DOMContentLoaded", () => {
    loadPrice();
    loadChart(7);

    // Day selector buttons
    document.querySelectorAll(".chart-day").forEach((btn) => {
      btn.addEventListener("click", () => {
        const days = parseInt(btn.dataset.days, 10);
        loadChart(days);

        // Highlight active
        document.querySelectorAll(".chart-day").forEach((b) => {
          b.style.borderColor = parseInt(b.dataset.days, 10) === days ? "var(--accent)" : "var(--border)";
        });
      });
      // Default active: 7d
      if (btn.dataset.days === "7") {
        btn.style.borderColor = "var(--accent)";
      }
    });
  });
</script>
